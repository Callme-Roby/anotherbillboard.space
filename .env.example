# Copy this file to .env.local for local development
# (`.env.local` is git-ignored; never commit real secrets).
#
# In production these are provided by Vercel: DATABASE_URL through the
# Neon Marketplace integration, the rest as manually configured Project
# Environment Variables.

# --- Database (Neon) ------------------------------------------------------
# Connection string for the `panels` / `buildings` tables (Drizzle ORM).
# Provided automatically once the Neon integration is connected on Vercel;
# for local dev, paste the connection string from the Neon dashboard.
DATABASE_URL=

# --- Stripe (Checkout, pay-what-you-want) ----------------------------------
# Not wired up yet — configured here ahead of the payment-flow step.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Realtime broadcast (Pusher) -------------------------------------------
# Not wired up yet — configured here ahead of the payment-flow step.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# --- Transactional email (Resend) ------------------------------------------
# Not wired up yet — configured here ahead of the payment-flow step.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
