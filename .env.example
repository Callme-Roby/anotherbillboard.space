# Copy this file to .env.local for local development
# (`.env.local` is git-ignored; never commit real secrets).
#
# In production these are provided by Vercel: DATABASE_URL through the
# Neon Marketplace integration, the rest as manually configured Project
# Environment Variables.

# --- Database (Neon) ------------------------------------------------------
# Connection string for the `panels` / `buildings` tables (Drizzle ORM).
# Provided automatically once the Neon integration is connected on Vercel;
# for local dev, paste the connection string from the Neon dashboard.
DATABASE_URL=

# --- Stripe (Checkout, pay-what-you-want) ----------------------------------
# STRIPE_SECRET_KEY: from the Stripe dashboard (Developers -> API keys).
# STRIPE_WEBHOOK_SECRET: from the webhook endpoint's settings (Developers ->
# Webhooks -> your endpoint -> Signing secret), listening for
# checkout.session.completed at /api/webhooks/stripe. No publishable key
# needed — checkout redirects via the session's own hosted URL, no
# Stripe.js on the client.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Realtime broadcast (Pusher) -------------------------------------------
# From a Pusher Channels app (free tier). NEXT_PUBLIC_* are safe to expose
# (Pusher's app key is meant to be public; it can only subscribe, not
# publish — publishing needs PUSHER_SECRET, server-side only).
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# --- Transactional email (Resend) ------------------------------------------
# RESEND_FROM_EMAIL must be on a domain verified in the Resend dashboard.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
